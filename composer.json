{
    "name": "packstub/filament-account-switcher",
    "description": "Switch between accounts in Filament: impersonate users, linked sub-accounts with password-confirmed escalation, and one-click developer logins. The panel UI of packstub/account-switcher.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v5",
        "filament-account-switcher",
        "filament-impersonate",
        "impersonate",
        "impersonation",
        "linked-accounts",
        "sub-accounts",
        "developer-login"
    ],
    "homepage": "https://github.com/packstub/filament-account-switcher",
    "support": {
        "issues": "https://github.com/packstub/filament-account-switcher/issues",
        "source": "https://github.com/packstub/filament-account-switcher",
        "docs": "https://packstub.dev/docs/filament-account-switcher"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "packstub/account-switcher": "^1.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\AccountSwitcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\AccountSwitcher\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\AccountSwitcher\\Filament\\FilamentAccountSwitcherServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
